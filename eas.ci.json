{
  "cli": {
    "version": "18.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "credentialsSource": "remote",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "credentialsSource": "remote",
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6751417631"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}