{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "mergeConfidence:all-badges"
  ],
  "enabledManagers": ["npm", "github-actions"],
  "cloneSubmodules": true,
  "cloneSubmodulesFilter": ["frontend"],
  "ignorePaths": [
    "**/node_modules/**",
    "frontend/**",
    "e2e_simulations/**",
    "modules/**"
  ],
  "semanticCommits": "enabled",
  "addLabels": ["bundle", "renovate"],
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 10,
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "rangeStrategy": "bump"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Shared with frontend: versions come from frontend/package.json via update-submodules",
      "matchPackageNames": [
        "react",
        "react-dom",
        "swr",
        "zustand",
        "i18next",
        "react-i18next",
        "react-hook-form",
        "styled-components",
        "js-cookie",
        "livekit-client",
        "prettier",
        "@a-little-world/little-world-prettier-config",
        "typescript"
      ],
      "enabled": false
    },
    {
      "description": "Expo SDK-bound packages: patch only, SDK upgrades go through `expo install --fix` by hand",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "babel-preset-expo",
        "react-test-renderer",
        "react-native",
        "react-native-*",
        "@types/react",
        "metro-*"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    },
    {
      "description": "Runtime majors need the full e2e suite: CI blocks merge until the e2e label is added",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "major_"
    }
  ]
}
