{
  "name": "little-world-app",
  "main": "expo-router/entry",
  "version": "1.2.3",
  "scripts": {
    "start": "pnpm run frontend:setup && expo start --port 9000",
    "start:tunnel": "expo start --port 9000 --tunnel",
    "start:expo-go": "EXPO_PUBLIC_USE_EXPO_GO=true expo start --port 9000 --clear --go",
    "start:dev-build": "EXPO_PUBLIC_USE_EXPO_GO=false expo start --port 9000",
    "reset-project": "node ./scripts/reset-project.js",
    "android-device": "expo run:android -d",
    "troubleshoot": "./scripts/dev-troubleshoot.sh",
    "android": "expo start --android --clear --port 9000",
    "dev:proxy": "./_scripts/schrodingers-nginx.sh",
    "android:expo-go": "EXPO_PUBLIC_USE_EXPO_GO=true expo start --android --port 9000 --clear --go",
    "android:dev-build": "EXPO_PUBLIC_USE_EXPO_GO=false expo start --android --port 9000",
    "ios": "expo start --ios --port 9000",
    "ios:expo-go": "EXPO_PUBLIC_USE_EXPO_GO=true expo start --ios --port 9000 --clear --go",
    "ios:dev-build": "EXPO_PUBLIC_USE_EXPO_GO=false expo start --ios --port 9000",
    "web": "expo start --web --port 9000",
    "lint": "expo lint",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore-cli",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore-cli",
    "prebuild": "expo prebuild --clean",
    "frontend:setup": "./_scripts/setup_local_frontend.sh && pnpm frontend:types",
    "frontend:types": "pnpm --dir frontend build:types",
    "export-web": "expo export --platform web --output-dir native_build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a-little-world/little-world-design-system-core": "^1.17.1",
    "@a-little-world/little-world-design-system-native": "^0.11.4",
    "@a-little-world/little-world-frontend-shared": "^0.1.1",
    "@babel/runtime": "^7.29.10",
    "@expo/app-integrity": "^0.1.10",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "~15.0.3",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@rn-primitives/portal": "^1.5.3",
    "@sentry/react-native": "~8.31.0",
    "call-audio": "file:./modules/call-audio",
    "expo": "~55.0.31",
    "expo-asset": "^55.0.20",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "^55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-doctor": "^1.19.8",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-jwt": "^1.8.2",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-modules-core": "~55.0.26",
    "expo-navigation-bar": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "expo-web-browser": "~55.0.20",
    "http-proxy-middleware": "^3.0.7",
    "i18next": "25.10.10",
    "js-cookie": "3.0.8",
    "livekit-client": "2.22.3",
    "react": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "15.7.4",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.5",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "styled-components": "6.5.3",
    "swr": "2.5.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@a-little-world/little-world-prettier-config": "2.0.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@expo/ngrok": "4.1.3",
    "@sentry/cli": "3.8.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "19.3.0",
    "babel-preset-expo": "55.0.25",
    "eas-cli": "25.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "metro-minify-terser": "0.83.3",
    "prettier": "3.8.4",
    "react-dom": "19.2.8",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.2.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "private": true,
  "prettier": "@a-little-world/little-world-prettier-config",
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "swr": "2.5.1",
      "zustand": "5.0.15",
      "i18next": "25.10.10",
      "react-i18next": "15.7.4",
      "react-hook-form": "7.87.0",
      "styled-components": "6.5.3",
      "js-cookie": "3.0.8",
      "livekit-client": "2.22.3",
      "prettier": "3.8.4",
      "@a-little-world/little-world-prettier-config": "2.0.0",
      "typescript": "5.9.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19.x",
        "react-dom": "19.x"
      }
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "core-js",
      "protobufjs",
      "react-native-libsodium",
      "@sentry/cli",
      "@sentry/react-native"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@livekit/react-native"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
