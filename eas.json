{
  "cli": {
    "version": "18.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "credentialsSource": "remote",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "credentialsSource": "remote",
      "distribution": "internal"
    },
    "staging": {
      "credentialsSource": "remote",
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6787037898",
        "ascApiKeyId": "Z9A9L2UQBX",
        "ascApiKeyIssuerId": "b6a04981-688e-4d91-8859-04f1611bd3ff",
        "ascApiKeyPath": "app-store-connect-api-key.p8"
      },
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "google-service-account-key.json"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6751417631",
        "ascApiKeyId": "Z9A9L2UQBX",
        "ascApiKeyIssuerId": "b6a04981-688e-4d91-8859-04f1611bd3ff",
        "ascApiKeyPath": "app-store-connect-api-key.p8"
      },
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "google-service-account-key.json"
      }
    }
  }
}